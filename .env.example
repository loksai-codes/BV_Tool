# Copy to .env and fill in. NEVER commit .env. Placeholders only.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Only for AUTH_MODE=service_principal (confidential client). Prefer a certificate / secret store in production.
CLIENT_SECRET=
REDIRECT_URI=http://localhost
# interactive | device_code | service_principal
AUTH_MODE=interactive
POWERBI_API_BASE_URL=https://api.powerbi.com/v1.0/myorg
DATABASE_URL=sqlite:///data/comparator.db
# Persist MSAL cache encrypted with a key held in the OS keyring (false = memory only)
PERSIST_TOKEN_CACHE=false
HEADLESS_BROWSER=true
EMBED_RENDER_TIMEOUT_MS=90000
DATA_RETENTION_DAYS=90
